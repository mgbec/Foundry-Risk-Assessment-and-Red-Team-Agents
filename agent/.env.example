# Copy to .env and fill in with values from `terraform output` (infra/).
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_AI_PROJECT_ENDPOINT=
RESULTS_STORAGE_ACCOUNT=

# What's under test -- see agent/targets.py. TARGET_KIND selects which of
# the two blocks below is required; the other can stay empty. A one-off
# override without touching this file: pass --target/--url/--deployment/etc
# to risk_assessment.py or red_team_scan.py directly.
TARGET_KIND=azure_deployment

# Required when TARGET_KIND=azure_deployment
TARGET_MODEL_DEPLOYMENT=

# Required when TARGET_KIND=http -- points at any external agent/model API.
# TARGET_HTTP_HEADERS is a JSON object, e.g. {"Authorization": "Bearer ..."}
TARGET_HTTP_URL=
TARGET_HTTP_METHOD=POST
TARGET_HTTP_HEADERS=
TARGET_HTTP_RESPONSE_PATH=response

# Currently unused by the installed RedTeam SDK (see red_team_scan.py) --
# kept here in case a future SDK version exposes an adversarial-model knob.
ADVERSARIAL_MODEL_DEPLOYMENT=

# Optional: enables OpenTelemetry tracing to Azure Monitor (see
# agent/observability.py). Leave unset to skip tracing entirely.
# Get the value with: terraform output -raw app_insights_connection_string
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional, defaults to unset (= content NOT captured). Traces routinely
# include red-team attack prompts and synthetic PII from
# sample_target_agent.py -- only turn this on if you've thought about where
# that content then lives.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=

# Optional: only needed once the agent-under-test is deployed.
# Leave unset for the first local run -- orchestrator.py will create it
# and set this for you within that process.
AZURE_AI_AGENT_NAME=
